node_modules/
dist/
release/
native/
.DS_Store
*.log

# The owner's private Obsidian notes for this project. They stay on the owner's Mac.
/Lectern/

# Design tooling (decision pages, sketches); PRODUCT.md and DESIGN.md stay in the repo
/.impeccable/

# Benchmark texts and download cache stay local (licences allow use; no need to republish). Manifests are kept.
/bench/data/*
!/bench/data/manifest.json
!/bench/data/splits.json

# Local working documents (audit reports and other inputs) stay out of the repository.
/output/

# Grammar benchmark: the ERRANT environment and the CWEB texts stay local (CC BY-NC-SA; not republished).
/bench/grammar/.venv/
/bench/grammar/data/*
!/bench/grammar/data/manifest.json
!/bench/grammar/data/splits.json

# Claude Code: agent worktrees (whole copies of the repo) and local settings stay out of git.
# The release skill (.claude/skills/release/) stays local too: the `release/` line above also matches it.
/.claude/worktrees/
/.claude/settings.local.json

# Search benchmark: downloaded gold data, the database response cache and the request counter stay local.
# The manifest, the splits (ids only), the hand-written SYNERGY and CLEF question files and the run summaries are kept; the long per-question
# ranked lists (*.lists.json) stay local.
/bench/search/data/*
!/bench/search/data/manifest.json
!/bench/search/data/splits.json
!/bench/search/data/synergy-questions.json
!/bench/search/data/clef-questions.json
/bench/search/results/*.lists.json
# The per-run JSON (plans and per-question metrics) stays local too: its queries are close copies of the questions,
# and the LitSearch dataset states no licence. The markdown summaries are kept.
/bench/search/results/*.json
